# Public configuration only. Do not put secrets, tokens, or recovery codes here.
# Copy to web/.env.local for a local dev server. .env.local is gitignored.
#
# Empty origin means the UI and API are the same origin.
# A dev loopback proxy may set this to http://127.0.0.1:<port>.
# Never use a wildcard credentialed CORS origin.
VITE_API_ORIGIN=
#
# Google client id is taken from POST /v1/auth/google/options.
# Do not embed an OAuth client secret in this SPA.
