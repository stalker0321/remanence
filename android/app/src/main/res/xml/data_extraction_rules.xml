<?xml version="1.0" encoding="utf-8"?>
<!-- Fail-safe MVP data-extraction policy (security.md section 5). Cloud backup
     and device-to-device transfer are denied for every storage domain so
     wrapped identity keysets, sealed session tokens, staged/decrypted media,
     fingerprint keys, Room rows, and ciphertext files never leave the device;
     none of it is restorable without its non-exportable Keystore KEK. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
        <exclude domain="device_root" />
        <exclude domain="device_file" />
        <exclude domain="device_database" />
        <exclude domain="device_sharedpref" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
        <exclude domain="device_root" />
        <exclude domain="device_file" />
        <exclude domain="device_database" />
        <exclude domain="device_sharedpref" />
    </device-transfer>
</data-extraction-rules>
