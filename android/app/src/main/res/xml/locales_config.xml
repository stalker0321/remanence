<?xml version="1.0" encoding="utf-8"?>
<!-- Per-app language support (Android 13+ system Settings screen and the
     AppCompat backport share this list). "System default" reset needs no
     entry: an empty app-locale list follows the device locale. -->
<locale-config xmlns:android="http://schemas.android.com/apk/res/android">
    <locale android:name="en" />
    <locale android:name="ru" />
    <locale android:name="uk" />
</locale-config>
