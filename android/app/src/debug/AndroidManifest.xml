<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">
    <application
        android:usesCleartextTraffic="true"
        tools:replace="android:usesCleartextTraffic">
        <!-- Test-only association; website DAL must also authorize the exact
             package and signer. Does not enable recovery in default builds. -->
        <meta-data android:name="asset_statements" android:resource="@string/recovery_asset_statements" />
        <!-- Harness for LocaleSelectActivityTest (Robolectric launches it by
             intent, so it must resolve in the test manifest). Explicit
             AppCompat theme: the delegate enforces it in onPostCreate.
             Production manifest is otherwise untouched. -->
        <activity
            android:name="dev.hryshyn.remanence.ui.locale.LocaleSelectHarnessActivity"
            android:theme="@style/Theme.AppCompat.Light.NoActionBar"
            android:exported="false" />
    </application>
</manifest>
